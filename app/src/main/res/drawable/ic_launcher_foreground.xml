<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Arka kart çerçevesi -->
    <item
        android:width="70dp"
        android:height="54dp"
        android:gravity="center">
        <rotate
            android:fromDegrees="-9"
            android:toDegrees="-9"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#00000000" />
                <stroke android:width="2dp" android:color="#D9D9E3" />
                <corners android:radius="14dp" />
            </shape>
        </rotate>
    </item>

    <!-- Ön kart çerçevesi -->
    <item
        android:width="70dp"
        android:height="54dp"
        android:gravity="center">
        <rotate
            android:fromDegrees="8"
            android:toDegrees="8"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#00000000" />
                <stroke android:width="2.5dp" android:color="#7C6FF0" />
                <corners android:radius="14dp" />
            </shape>
        </rotate>
    </item>

    <!-- Ortadaki büyük sarı şimşek -->
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="center"
        android:drawable="@drawable/ic_bolt" />

</layer-list>